// The storage rules DEPLOYED to skycare-yav (Oct 19 2026). Edit this file and deploy it to change the live rules.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /audits/{month}/{allPaths=**} {
      allow read: if true;
      allow create, update: if (request.resource.contentType == 'text/html'
                        || request.resource.contentType.matches('image/.*'))
                   && request.resource.size < 15 * 1024 * 1024;
      allow delete: if false;
    }

    // Procedures: uploaded videos (under 200 MB) and each step's photo (under 15 MB). Anyone can view;
    // files can only be added — nothing here can be replaced or deleted. The AI videos are saved by the
    // video maker job, which runs with admin rights, not these rules.
    match /procedures/{key}/{file} {
      allow read: if true;
      allow create: if (request.resource.contentType.matches('video/.*') && request.resource.size < 200 * 1024 * 1024)
                    || (request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024);
    }

    // Cargo photos (Log/Edit Cargo): anyone can view; photos under 15 MB can be added or replaced; nobody can delete.
    match /cargo/{id}/{file} {
      allow read: if true;
      allow create, update: if request.resource.contentType.matches('image/.*')
                            && request.resource.size < 15 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
